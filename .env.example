# CareConnect360 Environment Configuration Reference
# Local Development: Copy to .env
# Production (Render / Hosted): Set as environment variables in service dashboard

# Django Security
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True

# Host Configuration (comma-separated domains)
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Engine: Leave blank or set django.db.backends.mysql for local MySQL.
# Set django_tidb for production TiDB Cloud.
DB_ENGINE=django.db.backends.mysql

# MySQL Database Configuration
DB_NAME=careconnect360_db
DB_USER=root
DB_PASSWORD=your_local_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional SSL configuration for cloud MySQL
DB_SSL_MODE=
DB_SSL_CA=

# CORS & CSRF (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Production security settings (Render environment variables)
# ---------------------------------------------------------------------------
# These are NOT needed for local development (DEBUG=True disables them all).
# Set them in the Render service dashboard before go-live.

# Redirect HTTP → HTTPS. Leave True unless your load balancer handles it.
SECURE_SSL_REDIRECT=True

# Mark session and CSRF cookies as HTTPS-only.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HSTS: set to 31536000 (1 year) ONLY after HTTPS is confirmed working.
# Leave at 0 until you are ready. WARNING: browsers cache this value.
SECURE_HSTS_SECONDS=0

# Enable sub-domain HSTS and preload only after all subdomains serve HTTPS.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
